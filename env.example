# Copy to .env and fill in real values before running anywhere but
# your own machine. Never commit the real .env.
#
# ARACHNODE_SIGNING_SECRET and ARACHNODE_DISCERNMENT_KEY must be
# DIFFERENT values — one is held by the service, the other by a human
# approver, and the whole point of the Discernment Key gate is that
# holding the signing secret alone is not enough to loosen enforcement.

ARACHNODE_SIGNING_SECRET=
ARACHNODE_DISCERNMENT_KEY=

# The front-door login (HTTP Basic Auth) for the console and the whole
# API. This should also be different from the two secrets above — it's
# "who's allowed in the building," not "who's allowed to loosen a rule."
ARACHNODE_ADMIN_USER=
ARACHNODE_ADMIN_PASSWORD=

# Only needed outside Docker (the Dockerfile sets this to /data/arachnode.db itself).
# ARACHNODE_DATABASE_PATH=
